# Copy to backend/.env and fill in locally. NEVER commit .env.
# Phase 1 is read-only: there are no trading/execution settings.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API security ---
# Bearer token for every endpoint except /api/v1/health and /api/v1/ready.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If empty, protected endpoints return 503 (fail closed).
API_AUTH_TOKEN=
# Comma-separated browser origins allowed by CORS (empty = CORS disabled).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# --- Broker adapter ---
# mt5  = official MetaTrader5 package (Windows + MT5 terminal only)
# mock = deterministic SYNTHETIC data, labelled data_source=MOCK (dev/tests only)
MT5_ADAPTER=mt5
# Optional: path to terminal64.exe. If empty, the package locates the terminal.
MT5_TERMINAL_PATH=
# Optional: if empty, attaches to the account already logged in on the terminal.
# Use a DEMO account during development.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TIMEOUT_MS=10000
MT5_PORTABLE=false
MT5_RECONNECT_INTERVAL_SECONDS=15

# Broker trade-server timezone. MT5 timestamps are in SERVER time, not UTC.
# IANA name (handles DST) or fixed offset, e.g. UTC+2. Verify per broker:
# a tick with clock_skew_suspected=true or FUTURE_BAR issues means this is wrong.
MT5_SERVER_TIMEZONE=UTC

# --- Symbols ---
SYMBOL_UNIVERSE=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,EURGBP,EURJPY,EURCHF,EURAUD,EURCAD,GBPJPY,GBPCHF,GBPAUD,GBPCAD,AUDJPY,AUDNZD,AUDCAD,CADJPY
# JSON map canonical -> broker symbol, needed when a pair is AMBIGUOUS, e.g. {"EURUSD":"EURUSD.pro"}
SYMBOL_MAP_OVERRIDES={}

# --- Market data ---
TICK_MAX_AGE_SECONDS=30
CANDLES_MAX_COUNT=5000

# Mock adapter only: append a broker-style suffix (e.g. .r) to exercise mapping.
MOCK_SYMBOL_SUFFIX=
